<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JUSDATA - Mis trámites</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>
    <div class="logo"><a href="/inicio">JUSDATA</a></div>
    <nav>
        <ul>
            <li><a href="/inicio">Inicio</a></li>
            <li><a href="/tramite">Trámites</a></li>
            <li><a href="">Contacto</a></li>
            <% if (usuario) { %>
                <li><span style="color: #ffd700; font-weight: 600;">Hola, <%= usuario.nombre %></span></li>
                <li><a href="/cerrar-sesion">Cerrar sesión</a></li>
            <% } else { %>
                <li><a href="/login">Iniciar sesión</a></li>
            <% } %>
        </ul>
    </nav>
</header>

<div class="contenedor-seguimiento">

    <div class="seguimiento-encabezado">
        <h1>Mis trámites</h1>
        <a href="/nuevo-tramite" class="btn-nuevo-tramite">+ Nuevo trámite</a>
    </div>

    <% if (typeof tramites === 'undefined' || tramites.length === 0) { %>

        <div class="seguimiento-vacio">
            <p>Aún no tienes trámites registrados.</p>
            <a href="/tramite" class="btn-primary">Comenzar un trámite</a>
        </div>

    <% } else { %>

        <div class="lista-tramites">
            <% tramites.forEach(function(t) { %>
                <div class="tarjeta-tramite">

                    <div class="tarjeta-tramite-encabezado">
                        <h3>Folio: <%= t.folio %></h3>
                        <span class="estado-tag <%= t.estado === 'completado' ? 'completado' : 'en-proceso' %>">
                            <%= t.estado === 'completado' ? 'Completado' : 'En proceso' %>
                        </span>
                    </div>

                    <div class="tarjeta-tramite-cuerpo">
                        <p><strong>Tipo:</strong> <%= t.tipo_texto %></p>
                        <p><strong>Etapa actual:</strong> <%= t.etapa_texto %></p>
                        <p><strong>Fecha de inicio:</strong> <%= new Date(t.fecha_inicio).toLocaleDateString('es-MX') %></p>
                    </div>

                    <div class="tarjeta-tramite-acciones">
                        <a href="/continuar-tramite/<%= t.id %>" class="boton-accion boton-continuar">
                            <%= t.estado === 'completado' ? 'Ver / Editar' : 'Continuar trámite' %>
                        </a>
                        <a href="/reporte/<%= t.id %>" class="boton-accion boton-reporte">
                            Ver reporte
                        </a>
                    </div>

                </div>
            <% }); %>
        </div>

    <% } %>

</div>

</body>
</html>