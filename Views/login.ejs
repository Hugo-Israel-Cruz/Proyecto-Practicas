<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>JUSDATA - Iniciar Sesión</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">

    <div class="contenedor-login">
        <div class="login-box">
            <h2>Iniciar Sesión</h2>

            <% if (typeof error !== 'undefined' && error) { %>
                <p style="color: red; margin-bottom: 15px; font-weight: 600;"><%= error %></p>
            <% } %>

            <form action="/login" method="POST">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo" placeholder="Ingresa tu correo electrónico" required>
                <label for="contraseña">Contraseña</label>
                <input type="password" id="contraseña" name="contraseña" placeholder="Contraseña" required>
                <button type="submit">Entrar</button>
            </form>

            <p class="registro">¿No tienes cuenta?
                <a href="/registro">Crear cuenta</a>
            </p>
        </div>
    </div>

</body>
</html>